# Copy this file to .env and fill in real values.

# Local Postgres started via `docker compose up -d`
DATABASE_URL="postgresql://budget:budget@localhost:5432/budget?schema=public"

# Optional. Set this on Vercel (Project Settings → Environment Variables)
# and Vercel will automatically send it as a bearer token on cron-invoked
# requests, so /api/cron/keepalive and /api/cron/keepalive-dev only accept
# calls from Vercel Cron. Not needed for local dev.
CRON_SECRET=

# Optional. Set this on Vercel's *production* environment only (Vercel
# Cron only runs against production deployments) to the dev/preview
# Supabase project's connection string. /api/cron/keepalive-dev pings it
# daily so that project doesn't hit Supabase's 7-day inactivity pause —
# see the "Keeping the Supabase project awake" section in README.md.
# Not needed for local dev.
DEV_DATABASE_URL=
