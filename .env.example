# Copy this file to .env and fill in real values.

# Local Postgres started via `docker compose up -d`. Note: sign-in
# (Supabase Auth) only works against a real Supabase project's Postgres —
# this plain local container has no `auth` schema. Point DATABASE_URL at
# a Supabase project's connection string instead if you need to actually
# sign in locally; see docs/adr/0006 for why local/e2e don't get one.
DATABASE_URL="postgresql://budget:budget@localhost:5432/budget?schema=public"

# Optional. Set this on Vercel (Project Settings → Environment Variables)
# and Vercel will automatically send it as a bearer token on cron-invoked
# requests, so /api/cron/keepalive only accepts calls from Vercel Cron.
# Not needed for local dev.
CRON_SECRET=

# Supabase Auth (see docs/adr/0005, docs/adr/0006). Project Settings ->
# API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
# The anon/publishable key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Server-only — used for admin.inviteUserByEmail/admin.deleteUser
# (invite flow, #73) and scripts/bootstrap-first-owner.ts. Never expose
# this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Google sign-in (#86) needs no env var of its own here — the Google
# OAuth client id/secret are configured directly in the Supabase
# dashboard (Authentication -> Providers -> Google), not in this app.
# See README.md's Authentication section for the setup steps.
