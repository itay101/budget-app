// Prisma schema for a personal YNAB-style budgeting app.
//
// Money is stored as integer "milliunits" everywhere (amount * 1000), the
// same convention YNAB's own API uses — it avoids floating point rounding
// issues and keeps three decimal places of precision. $12.34 == 12340.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A budget is also the unit a currency lives in: every account, category,
// and transaction hangs off exactly one budget, so they all share that
// budget's currency. A user who wants to track money in more than one
// currency opens a separate budget per currency (see the partial unique
// index on `(ownerId, currency)` added in migrations — "partial" because
// it only applies `WHERE deleted = false`, so a deleted budget frees its
// currency up for reuse; Prisma's schema DSL can't express that, which is
// why it isn't declared as an `@@unique` here) rather than mixing
// currencies within one. Scoped per-owner (not a bare `currency` unique
// constraint) as of 20260913150000_budget_owner_not_null — otherwise two
// different Users could never each have their own USD budget.
model Budget {
  id             String          @id @default(cuid())
  name           String
  currency       String          @default("USD")
  // Soft delete: deleteBudget (src/app/budgets/actions.ts) sets this and
  // closes the budget's accounts, but never removes rows — actual removal
  // is left to a future cleanup job that doesn't exist yet. A deleted
  // budget is invisible to every query in src/lib/budget.ts.
  deleted        Boolean         @default(false)
  // The single User this Budget belongs to (ADR 0001 — a direct FK, not a
  // membership row, so "who owns this" is always exactly one unambiguous
  // value). `onDelete: Restrict` is defensive: in practice a User row is
  // never actually deleted (ADR 0005), only deactivated, and the
  // deactivation trigger in the foundation migration is what really
  // enforces "can't orphan an owned Budget" — see that trigger's own
  // comment. Required (matching ADR 0005) as of the
  // 20260913150000_budget_owner_not_null migration — it shipped nullable
  // for one migration first; see that migration's comment and ADR 0006
  // for why.
  ownerId        String          @db.Uuid
  owner          User            @relation("BudgetOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accounts       Account[]
  categoryGroups CategoryGroup[]
  payees         Payee[]
  memberships    BudgetMembership[]
  invites        Invite[]
  auditEntries   AuditEntry[]
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
  LINE_OF_CREDIT
  OTHER
}

model Account {
  id           String        @id @default(cuid())
  budgetId     String
  budget       Budget        @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  name         String
  type         AccountType   @default(CHECKING)
  onBudget     Boolean       @default(true)
  closed       Boolean       @default(false)
  // Cached running balance in milliunits, kept in sync when transactions change.
  balance      Int           @default(0)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([budgetId])
}

model CategoryGroup {
  id         String     @id @default(cuid())
  budgetId   String
  budget     Budget     @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int        @default(0)
  categories Category[]

  @@index([budgetId])
}

model Category {
  id              String          @id @default(cuid())
  categoryGroupId String
  categoryGroup   CategoryGroup   @relation(fields: [categoryGroupId], references: [id], onDelete: Cascade)
  name            String
  sortOrder       Int             @default(0)
  // A hidden category keeps its real categoryGroupId/sortOrder — hiding
  // is purely presentational. The budget page groups every hidden
  // category (from any group) under a synthetic "Hidden" section at the
  // end, and unhiding puts it right back where it was.
  hidden          Boolean         @default(false)
  months          CategoryMonth[]
  transactions    Transaction[]

  @@index([categoryGroupId])
}

// One row per (category, month): how much was budgeted ("assigned") to a
// category in a given month. Activity and available-to-spend are derived
// at read time from budgeted amounts + transactions, rather than stored.
model CategoryMonth {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  // Always normalized to the first of the month.
  month      DateTime
  budgeted   Int      @default(0)

  @@unique([categoryId, month])
  @@index([month])
}

model Payee {
  id           String        @id @default(cuid())
  budgetId     String
  budget       Budget        @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  name         String
  transactions Transaction[]

  @@index([budgetId])
}

enum ClearedStatus {
  UNCLEARED
  CLEARED
  RECONCILED
}

model Transaction {
  id         String        @id @default(cuid())
  accountId  String
  account    Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  payeeId    String?
  payee      Payee?        @relation(fields: [payeeId], references: [id])
  categoryId String?
  category   Category?     @relation(fields: [categoryId], references: [id])
  date       DateTime
  // Milliunits. Negative = outflow, positive = inflow.
  amount     Int
  memo       String?
  cleared    ClearedStatus @default(UNCLEARED)
  approved   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([accountId])
  @@index([categoryId])
  @@index([payeeId])
  @@index([date])
}

// Authentication + budget sharing (see #56/#69, CONTEXT.md, and
// docs/adr/0001 through 0005). `id` is a `uuid`, not this schema's usual
// `cuid()` text id, because it must equal `auth.users.id` verbatim —
// Supabase's own guidance is to reference nothing else off `auth.users`,
// since every other column there can change out from under you. A
// Postgres trigger (this migration) mirrors `auth.users` into this table
// on signup and on email change; nothing here is ever written by the app
// directly except `deactivatedAt`.
model User {
  id            String    @id @db.Uuid
  // Lower-cased on write (by the mirroring trigger, and by app code for
  // the one column it does touch — deactivatedAt).
  email         String
  // "Deleting your account" deactivates the User (this timestamp) and
  // truly deletes the underlying Supabase credentials, but never removes
  // this row (ADR 0005) — AuditEntry.actorId stays a plain required FK,
  // permanently resolvable, forever. See the "prevent orphaning" trigger
  // below for the backstop this implies.
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ownedBudgets Budget[]           @relation("BudgetOwner")
  memberships  BudgetMembership[]
  invitesSent  Invite[]
  auditEntries AuditEntry[]

  // A partial unique index enforces email uniqueness only among active
  // users (`WHERE "deactivatedAt" IS NULL`) — Prisma's schema DSL can't
  // express that, so it lives in migration SQL instead, same as
  // `Budget.currency` above. A later invite to the same address (after
  // the old account's Supabase credentials were deleted) is then free to
  // create a new, distinct User row.
}

// A User, other than the Owner, granted access to a Budget (ADR 0001) — no
// `role` column, since Collaborator is the only access level in scope.
// No status either: a row's existence *is* the membership; removal or
// leaving (ADR 0004) deletes it outright, immediately, no grace period.
model BudgetMembership {
  id        String   @id @default(cuid())
  budgetId  String
  budget    Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([budgetId, userId])
  @@index([userId])
}

// A pending, email-addressed request to become a Collaborator on a
// Budget (ADR 0003). No `status` column — the row's mere existence is
// "pending"; both acceptance (-> BudgetMembership) and cancellation
// delete it outright, and AuditEntry is the permanent record of what
// happened to it. No app-level expiry either (relies on Supabase's own
// magic-link OTP expiry).
model Invite {
  id        String @id @default(cuid())
  // Lower-cased on write.
  email     String
  budgetId  String
  budget    Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  invitedBy String @db.Uuid
  inviter   User   @relation(fields: [invitedBy], references: [id])
  // true: this Invite created a fresh, unconfirmed auth.users row via
  //   admin.inviteUserByEmail — canceling must admin.deleteUser it too
  //   (ADR 0003), or the old invite link keeps working.
  // false: the email already had a confirmed account when invited — no
  //   Supabase-side row exists for this Invite, so canceling must never
  //   touch Supabase auth.
  createdSupabaseUser Boolean
  createdAt           DateTime @default(now())

  @@unique([budgetId, email])
  // Supports the accept-time lookup ("does the signed-in user's email
  // have a pending Invite anywhere?"), separate from the per-budget
  // uniqueness check above.
  @@index([email])
}

// Covers every Budget-scoped mutation: accounts, categories, category-
// month budgeted amounts, payees, transactions, and membership changes
// (invites, collaborator removal, ownership transfer) — see ADR 0002.
enum AuditEntityType {
  BUDGET
  ACCOUNT
  CATEGORY_GROUP
  CATEGORY
  CATEGORY_MONTH
  PAYEE
  TRANSACTION
  BUDGET_MEMBERSHIP
  INVITE
}

// One polymorphic table per change (ADR 0002), rather than one table per
// entity type or a full-row snapshot: a single "everything that happened
// on this budget" query, at the cost of `entityId` not being a real FK —
// referential integrity there is an app-layer concern, not the schema's.
// Kept forever; no retention/pruning in scope.
model AuditEntry {
  id         String          @id @default(cuid())
  budgetId   String
  budget     Budget          @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  entityType AuditEntityType
  // Not a real FK — see the model comment.
  entityId   String
  // Free text, not an enum: covers generic CRUD ("created"/"updated"/
  // "deleted") and the membership-specific phrasing ADR 0002/0004 use
  // verbatim ("invite sent"/"accepted"/"revoked", "collaborator
  // removed", "ownership transferred").
  action     String
  // Always a User — never a system/cron process, since this only covers
  // changes made by people. Required, no special onDelete behavior: safe
  // only because User rows are never hard-deleted (ADR 0005).
  actorId    String          @db.Uuid
  actor      User            @relation(fields: [actorId], references: [id])
  // Field-level diff: `{ fieldName: [oldValue, newValue] }`.
  changes    Json
  createdAt  DateTime        @default(now())

  @@index([budgetId, createdAt])
  @@index([entityType, entityId])
}
